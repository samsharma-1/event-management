# PlanVibe AI Environment Configuration

# Google Gemini Model (defaults to gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini API Key for demo/local evaluation
# NOTE: In client-side SPA environments, keys in VITE_* or localStorage are visible in browser DevTools.
# For production deployments beyond demos, proxy LLM requests through a secure serverless function or backend.
VITE_GEMINI_API_KEY=